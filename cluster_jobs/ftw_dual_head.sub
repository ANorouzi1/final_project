universe                = docker
docker_image            = nvidia/cuda:11.4.3-runtime-ubuntu20.04
executable              = execute_hlcv.sh

arguments               = run_experiment.py --config ftw_dual_head

output                  = /home/hlcv_teamxxx/condor_logs/ftw_dual_head.$(ClusterId).$(ProcId).out
error                   = /home/hlcv_teamxxx/condor_logs/ftw_dual_head.$(ClusterId).$(ProcId).err
log                     = /home/hlcv_teamxxx/condor_logs/ftw_dual_head.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

request_GPUs = 1
request_CPUs = 2
request_memory = 16G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue 1
